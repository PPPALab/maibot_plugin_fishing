{
  "manifest_version": 2,
  "id": "fishing.astrbot-native",
  "name": "钓鱼小游戏",
  "version": "1.0.0",
  "description": "钓鱼小游戏，支持钓鱼、市场、商店、抽卡等，移植自 AstrBot。",
  "author": {"name": "xxlemon; sakuradairong upstream contributors; MaiBot native port contributors", "url": "https://github.com/sakuradairong/astrbot_plugin_fishing"},
  "license": "AGPL-3.0-only",
  "host_application": {"min_version": "1.3.19", "max_version": "1.3.19"},
  "sdk": {"min_version": "2.20.0", "max_version": "2.20.0"},
  "dependencies": [
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10.4,<14"},
    {"type": "python_package", "name": "PyYAML", "version_spec": ">=6,<7"},
    {"type": "python_package", "name": "tomlkit", "version_spec": ">=0.13,<1"},
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.10,<4"},
    {"type": "python_package", "name": "fonttools", "version_spec": ">=4.55,<5"},
    {"type": "python_package", "name": "hypercorn", "version_spec": ">=0.17,<0.19"},
    {"type": "python_package", "name": "numpy", "version_spec": ">=1.26,<3"},
    {"type": "python_package", "name": "quart", "version_spec": ">=0.20,<0.23"},
    {"type": "python_package", "name": "requests", "version_spec": ">=2.32,<3"}
  ],
  "capabilities": ["send.text", "send.image", "send.custom", "config.get"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "urls": {
    "repository": "https://github.com/PPPALab/maibot_plugin_fishing",
    "documentation": "https://github.com/PPPALab/maibot_plugin_fishing/blob/main/README.md",
    "issues": "https://github.com/PPPALab/maibot_plugin_fishing/issues"
  }
}
